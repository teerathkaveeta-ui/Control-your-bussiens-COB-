{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "A business transaction record.",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense", "debt", "payment"] },
        "description": { "type": "string" },
        "customerName": { "type": "string" },
        "rawInput": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["amount", "type", "timestamp"]
    },
    "Customer": {
      "title": "Customer",
      "description": "A customer profile with debt tracking.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "totalDebt": { "type": "number" },
        "phone": { "type": "string" }
      },
      "required": ["name", "totalDebt"]
    },
    "Product": {
      "title": "Product",
      "description": "A product in the shop's rate list.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["name", "price"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A system or AI generated notification.",
      "type": "object",
      "properties": {
        "item": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "rawTranscript": { "type": "string" }
      },
      "required": ["message", "timestamp"]
    },
    "ShopSettings": {
      "title": "Shop Settings",
      "description": "Configuration and state for the shop.",
      "type": "object",
      "properties": {
        "shopOn": { "type": "boolean" },
        "lastSessionStart": { "type": "number" },
        "coins": { "type": "number" },
        "shopSize": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/businesses/{businessId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Collection of transactions for a business."
    },
    "/businesses/{businessId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Collection of customers for a business."
    },
    "/businesses/{businessId}/products/{productId}": {
      "schema": "Product",
      "description": "Rate list products."
    },
    "/businesses/{businessId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notifications for the business owner."
    },
    "/businesses/{businessId}/settings/main": {
      "schema": "ShopSettings",
      "description": "Main settings and status document."
    }
  }
}
