rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(businessId) {
      return isSignedIn() && request.auth.uid == businessId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidTransaction(data) {
      return data.keys().hasAll(['amount', 'type', 'timestamp']) &&
             data.amount is number &&
             data.type is string &&
             (data.customerName == null || data.customerName is string) &&
             (data.description == null || data.description is string);
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'totalDebt']) &&
             data.keys().size() <= 3 &&
             data.name is string && data.name.size() <= 100 &&
             data.totalDebt is number &&
             (data.phone == null || (data.phone is string && data.phone.size() <= 20));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price']) &&
             data.keys().size() <= 5 &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             (data.description == null || (data.description is string && data.description.size() <= 500)) &&
             (data.inStock == null || data.inStock is bool);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['message', 'timestamp']) &&
             data.keys().size() <= 6 &&
             data.message is string && data.message.size() <= 2000 &&
             (data.item == null || (data.item is string && data.item.size() <= 100)) &&
             (data.rawTranscript == null || (data.rawTranscript is string && data.rawTranscript.size() <= 2000));
    }

    function isValidShopSettings(data) {
      return data.keys().size() <= 15 &&
             (data.shopOn == null || data.shopOn is bool) &&
             (data.lastSessionStart == null || data.lastSessionStart is number) &&
             (data.coins == null || data.coins is number) &&
             (data.shopSize == null || data.shopSize is string) &&
             (data.whatsappNumber == null || data.whatsappNumber is string) &&
             (data.whatsappApiKey == null || data.whatsappApiKey is string);
    }

    match /businesses/{businessId} {
      allow get: if isOwner(businessId);
      
      match /transactions/{transactionId} {
        allow list: if isOwner(businessId);
        allow get: if isOwner(businessId) && isValidId(transactionId);
        allow create: if isOwner(businessId) && isValidId(transactionId) && isValidTransaction(incoming());
        allow update: if isOwner(businessId) && isValidId(transactionId) && isValidTransaction(incoming()) && 
                         incoming().diff(existing()).affectedKeys().hasOnly(['description', 'customerName']);
        allow delete: if isOwner(businessId);
      }

      match /customers/{customerId} {
        allow list: if isOwner(businessId);
        allow get: if isOwner(businessId) && isValidId(customerId);
        allow create: if isOwner(businessId) && isValidId(customerId) && isValidCustomer(incoming());
        allow update: if isOwner(businessId) && isValidId(customerId) && isValidCustomer(incoming());
        allow delete: if isOwner(businessId);
      }

      match /products/{productId} {
        allow list: if isOwner(businessId);
        allow get: if isOwner(businessId) && isValidId(productId);
        allow create: if isOwner(businessId) && isValidId(productId) && isValidProduct(incoming());
        allow update: if isOwner(businessId) && isValidId(productId) && isValidProduct(incoming());
        allow delete: if isOwner(businessId);
      }

      match /notifications/{notificationId} {
        allow list: if isOwner(businessId);
        allow create: if isOwner(businessId) && isValidId(notificationId) && isValidNotification(incoming());
        allow delete: if isOwner(businessId);
      }

      match /settings/main {
        allow get, write: if isOwner(businessId);
      }
    }

    match /app_config/gemini {
      allow get: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == 'teerathkaveeta@gmail.com';
    }
  }
}
