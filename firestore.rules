rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(businessId) {
      return isSignedIn() && request.auth.uid == businessId;
    }

    // 2. Validation Blueprints
    function isValidTransaction(data) {
      return data.keys().hasAll(['amount', 'type', 'timestamp']) &&
             data.amount is number && data.amount >= 0 &&
             data.type in ['income', 'expense', 'debt'] &&
             data.timestamp == request.time &&
             (data.get('description', '') is string && data.get('description', '').size() <= 1000) &&
             (data.get('rawInput', '') is string && data.get('rawInput', '').size() <= 2000);
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() <= 100 &&
             (data.get('phone', '') is string && data.get('phone', '').size() <= 20) &&
             (data.get('totalDebt', 0) is number);
    }

    function isValidMemory(data) {
      return data.keys().hasAll(['content', 'date', 'type']) &&
             data.content is string && data.content.size() <= 5000 &&
             data.date is string &&
             data.type in ['daily_summary', 'critical_alert', 'general_note'];
    }

    // 3. Collection Rules
    match /businesses/{businessId} {
      allow read: if isOwner(businessId);
      allow create: if isOwner(businessId);
      
      match /transactions/{transactionId} {
        allow get: if isOwner(businessId) && isValidId(transactionId);
        allow list: if isOwner(businessId);
        allow create: if isOwner(businessId) && isValidId(transactionId) && isValidTransaction(request.resource.data);
        allow update: if false; // Transactions are usually immutable for integrity
        allow delete: if isOwner(businessId) && isValidId(transactionId);
      }

      match /customers/{customerId} {
        allow get: if isOwner(businessId) && isValidId(customerId);
        allow list: if isOwner(businessId);
        allow create: if isOwner(businessId) && isValidId(customerId) && isValidCustomer(request.resource.data);
        allow update: if isOwner(businessId) && isValidId(customerId) && 
                         isValidCustomer(request.resource.data) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalDebt', 'phone', 'name']);
        allow delete: if isOwner(businessId) && isValidId(customerId);
      }

      match /memories/{memoryId} {
        allow get: if isOwner(businessId) && isValidId(memoryId);
        allow list: if isOwner(businessId);
        allow create: if isOwner(businessId) && isValidId(memoryId) && isValidMemory(request.resource.data);
        allow delete: if isOwner(businessId) && isValidId(memoryId);
      }
    }
  }
}
